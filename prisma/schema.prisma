generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model bom_components {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id       String?   @db.Uuid
  part_code        String
  part_description String?
  part_type        String?
  per_shipper      Decimal?  @db.Decimal
  products         products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_bom_components_product_id")
}

model forecasts {
  id            BigInt   @id @default(autoincrement())
  forecast_date DateTime @db.Date
  quantity      Int
  product_code  String?
  description   String?
}

model po_counters {
  customer_name String @id
  last_sequence Int    @default(0)
}

model po_status_history {
  id              BigInt          @id @default(autoincrement())
  po_id           String          @db.Uuid
  status          String
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  purchase_orders purchase_orders @relation(fields: [po_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model products {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_code      String            @unique
  description       String?
  units_per_shipper Int?
  daily_run_rate    Decimal?          @db.Decimal
  hourly_run_rate   Decimal?          @db.Decimal
  mins_per_shipper  Decimal?          @db.Decimal
  price_per_shipper Decimal?          @db.Decimal
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  is_active         Boolean           @default(true)
  
  // NEW ERP FIELDS
  customer_id       String?           @db.Uuid
  customer          Customer?         @relation(fields: [customer_id], references: [id])
  category          String?
  uom               String            @default("Each")

  bom_components    bom_components[]
  purchase_orders   purchase_orders[]

  @@index([product_code(ops: raw("gin_trgm_ops")), description(ops: raw("gin_trgm_ops"))], map: "idx_product_search", type: Gin)
}

model purchase_orders {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  po_number               String              @unique
  sequence                Int
  product_id              String?             @db.Uuid
  customer_name           String              // Kept for legacy/historical purposes
  customer_id             String?             @db.Uuid // NEW: Links to Customer table
  customer                Customer?           @relation(fields: [customer_id], references: [id])
  po_created_date         DateTime?           @db.Date
  po_received_date        DateTime?           @db.Date
  requested_delivery_date DateTime?           @db.Date
  ordered_qty_pieces      Int
  ordered_qty_shippers    Decimal             @db.Decimal
  customer_amount         Decimal             @db.Decimal
  system_amount           Decimal             @db.Decimal
  current_status          String              @default("Open")
  delivery_date           DateTime?           @db.Date
  delivery_docket_number  String?
  created_at              DateTime            @default(now()) @db.Timestamptz(6)
  updated_at              DateTime            @default(now()) @db.Timestamptz(6)
  description             String?
  hourly_run_rate         Decimal?            @db.Decimal
  mins_per_shipper        Decimal?            @db.Decimal
  po_status_history       po_status_history[]
  products                products?           @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@index([product_id], map: "idx_po_product_id")
  @@index([customer_id], map: "idx_po_customer_id")
  @@index([po_number(ops: raw("gin_trgm_ops"))], map: "idx_po_search", type: Gin)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model soh {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id      String?
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  import_batch_id String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  import_source   String?   @default("manual_upload")
  description     String?
  stock_on_hand   Decimal?  @db.Decimal
  default_uom     String?
  locations       String?
  ean             String?
  weight_kg       Decimal?  @db.Decimal
  volume_m3       Decimal?  @db.Decimal

  @@index([created_at], map: "idx_soh_created_at")
  @@index([ean], map: "idx_soh_ean")
  @@index([import_batch_id], map: "idx_soh_import_batch_id")
  @@index([product_id], map: "idx_soh_product_id")
  @@index([product_id], map: "idx_soh_product_id_text")
  @@index([stock_on_hand], map: "idx_soh_stock_on_hand")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  password  String
  name      String
  role      String   @default("WAREHOUSE") // PLANNER, ADMIN, QA, etc.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("users") // Maps to a table named 'users' in Supabase
}

// NEW: Dedicated Address Model for Autocomplete & Geolocation
model Address {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_number    String?  // Unit or Building Number
  street_address String?  // Street name and number (e.g., "123 Main St")
  city           String?
  state          String?  // State or Province
  postal_code    String?
  country        String?  // Country (e.g., "Australia")
  country_code   String?  // ISO Code (e.g., "AU")
  latitude       Decimal? @db.Decimal // Geolocation coordinate
  longitude      Decimal? @db.Decimal // Geolocation coordinate

  // Relations (A customer can have multiple addresses)
  customer_shipping AddressCustomerShipping[]
  customer_billing  AddressCustomerBilling[]

  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("addresses")
}

model Customer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_code String   @unique
  legal_name    String
  trading_name  String?
  tax_id        String?
  
  // Categorization & Status
  status        String   @default("ACTIVE")
  customer_type String   @default("STANDARD")
  industry      String?
  
  // Financial & Credit
  payment_terms               String?
  credit_limit                Decimal  @default(0) @db.Decimal
  credit_rating               String?
  last_credit_review_date     DateTime? @db.Timestamptz(6)
  default_currency            String  @default("USD")
  default_discount_percentage Decimal  @default(0) @db.Decimal
  accounts_receivable_code   String?
  minimum_order_value         Decimal  @default(0) @db.Decimal
  is_tax_exempt               Boolean @default(false)
  tax_exempt_certificate_number String?
  
  // Logistics
  sales_territory           String?
  default_shipping_method   String?
  shipping_carrier_account String?
  lead_time_days            Int?
  delivery_window_start     String?
  delivery_window_end       String?
  
  // Pallet Preferences
  pallet_preference       String?
  pallet_account_number   String?
  
  // Contact Info
  primary_contact_name    String?
  primary_contact_email   String?
  primary_contact_phone   String?
  accounts_payables_email String?
  delivery_contact_phone  String?
  
  // System & Audit
  notes        String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  // Relations to Address Table
  shipping_addresses AddressCustomerShipping[]
  billing_addresses  AddressCustomerBilling[]

  // Relations to Products and POs
  products       products[]
  purchase_orders purchase_orders[]

  @@map("customers")
}

// Join tables to allow a customer to have multiple shipping and billing addresses
model AddressCustomerShipping {
  customer_id String @db.Uuid
  address_id  String @db.Uuid
  
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  address  Address  @relation(fields: [address_id], references: [id], onDelete: Cascade)

  @@id([customer_id, address_id])
  @@map("customer_shipping_addresses")
}

model AddressCustomerBilling {
  customer_id String @db.Uuid
  address_id  String @db.Uuid
  
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  address  Address  @relation(fields: [address_id], references: [id], onDelete: Cascade)

  @@id([customer_id, address_id])
  @@map("customer_billing_addresses")
}